{
  "name": "hato",
  "version": "0.1.7",
  "private": true,
  "type": "module",
  "description": "Personal companion & delegated task agent",
  "bin": {
    "hato": "./src/cli/hato.ts"
  },
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "setup": "bun src/cli/setup.ts",
    "statics": "bun src/cli/statics.ts",
    "start": "bun src/main.ts",
    "build:web": "bun run --cwd web build",
    "dev:web": "bun run --cwd web dev",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test --timeout 20000 tests/",
    "release:pack": "bash scripts/pack-release.sh"
  },
  "dependencies": {
    "@clack/prompts": "^1.9.0",
    "@earendil-works/pi-agent-core": "^1.5.2",
    "@earendil-works/pi-ai": "^1.5.2",
    "@earendil-works/pi-schema": "^1.5.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@sinclair/typebox": "^0.34.52",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "grammy": "^1.46.0",
    "https-proxy-agent": "^9.1.0",
    "playwright-core": "^1.65.1",
    "smol-toml": "^1.9.1",
    "socks-proxy-agent": "^10.1.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
