{
  "name": "hato",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Personal companion & delegated task agent",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "setup": "tsx src/cli/setup.ts",
    "statics": "tsx src/cli/statics.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test tests/**/*.test.ts"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@clack/prompts": "^1.9.0",
    "@earendil-works/pi-agent-core": "^1.5.2",
    "@earendil-works/pi-ai": "^1.5.2",
    "@earendil-works/pi-schema": "^1.5.2",
    "@sinclair/typebox": "^0.34.52",
    "better-sqlite3": "^13.2.0",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "grammy": "^1.46.0",
    "https-proxy-agent": "^9.1.0",
    "playwright-core": "^1.65.1",
    "smol-toml": "^1.9.1",
    "socks-proxy-agent": "^10.1.0",
    "undici": "^8.12.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
