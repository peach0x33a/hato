# 仅存放 API Key / Bot Token 等敏感凭据；其余所有配置请在 config/hato.toml 与 config/models.toml 中修改
#
# 模型 Provider API Key 规则：
#   环境变量名按 config/models.toml 中 Provider 的 Slug 自动推导为 `<UPPER_SNAKE(slug)>_API_KEY`
#   例如：
#     [providers.custom-relay]    -> CUSTOM_RELAY_API_KEY
#     [providers.google-gateway]  -> GOOGLE_GATEWAY_API_KEY
#     [providers.openai-gateway]  -> OPENAI_GATEWAY_API_KEY
#     [providers.anthropic-relay] -> ANTHROPIC_RELAY_API_KEY
#     [providers.deepseek]        -> DEEPSEEK_API_KEY

TG_BOT_TOKEN=
TAVILY_API_KEY=
GOOGLE_GATEWAY_API_KEY=
OPENAI_GATEWAY_API_KEY=
ANTHROPIC_RELAY_API_KEY=
CUSTOM_RELAY_API_KEY=
DEEPSEEK_API_KEY=

# Planned (QQ / Hindsight 云端向量服务)
QQ_BOT_SECRET=
QWEN_EMBEDDING_API_KEY=
QWEN_RERANKER_API_KEY=
